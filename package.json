{
  "name": "service-graph",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm --filter @service-graph/contracts build && pnpm --filter @service-graph/server build && pnpm --filter @service-graph/client build",
    "dev": "pnpm --filter @service-graph/contracts build && pnpm --parallel --filter @service-graph/server --filter @service-graph/client dev",
    "test": "pnpm --filter @service-graph/contracts build && pnpm --filter @service-graph/server test"
  },
  "devDependencies": {
    "vite-plus": "^1.3.0"
  }
}
